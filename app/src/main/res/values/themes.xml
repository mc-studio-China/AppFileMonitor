<resources>
    <style name="Theme.AppFileMonitor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#D6E4FF</item>
        <item name="colorOnPrimaryContainer">#001B3F</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F6F8FC</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
    </style>
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
